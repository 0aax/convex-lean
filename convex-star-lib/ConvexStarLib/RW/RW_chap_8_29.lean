open BigOperators Real Nat Topology Rat MeasureTheory Pointwise ENNReal NNReal

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [FiniteDimensional ℝ E]
variable {F : Type*} [NormedAddCommGroup F] [InnerProductSpace ℝ F] [FiniteDimensional ℝ F]

/-! ## Auxiliary lemmas -/

/-- The cone generated by a finite family. -/
def genCone {V : Type*} [AddCommGroup V] [Module ℝ V] {ι : Type*} [Fintype ι] (g : ι → V) :
    Set V :=
  {x | ∃ μ : ι → ℝ, (∀ j, 0 ≤ μ j) ∧ x = ∑ j, μ j • g j}

-- ===== block M =====
theorem M_genCone_subset {V : Type*} [AddCommGroup V] [Module ℝ V] {ι κ : Type*} [Fintype ι]
    [Fintype κ] (g : ι → V) (g' : κ → V) (h : ∀ i, g' i ∈ genCone g) :
    genCone g' ⊆ genCone g := by
  choose ν hν0 hν using h
  rintro x ⟨μ, hμ0, rfl⟩
  refine ⟨fun j => ∑ i, μ i * ν i j,
    fun j => Finset.sum_nonneg (fun i _ => mul_nonneg (hμ0 i) (hν0 i j)), ?_⟩
  simp_rw [hν, Finset.smul_sum, smul_smul, Finset.sum_smul]
  exact Finset.sum_comm

theorem M_genCone_nonpos {V : Type*} [AddCommGroup V] [Module ℝ V] {κ : Type*}
    [Fintype κ] (g' : κ → V) (f : Module.Dual ℝ V) (h : ∀ i, f (g' i) ≤ 0) :
    genCone g' ⊆ {x | f x ≤ 0} := by
  rintro x ⟨μ, hμ0, rfl⟩
  simp only [Set.mem_setOf_eq, map_sum, map_smul, smul_eq_mul]
  exact Finset.sum_nonpos (fun i _ => mul_nonpos_of_nonneg_of_nonpos (hμ0 i) (h i))

theorem M_mem_gen {V : Type*} [AddCommGroup V] [Module ℝ V] {ι : Type*} [Fintype ι]
    (g : ι → V) (j : ι) : g j ∈ genCone g := by
  classical
  refine ⟨fun l => if l = j then 1 else 0, fun l => by dsimp only; split_ifs <;> norm_num, ?_⟩
  simp

theorem M_zero_mem {V : Type*} [AddCommGroup V] [Module ℝ V] {ι : Type*} [Fintype ι]
    (g : ι → V) : (0 : V) ∈ genCone g :=
  ⟨fun _ => 0, fun _ => le_refl 0, by simp⟩

theorem M_add_mem {V : Type*} [AddCommGroup V] [Module ℝ V] {ι : Type*} [Fintype ι]
    (g : ι → V) {x y : V} (hx : x ∈ genCone g) (hy : y ∈ genCone g) : x + y ∈ genCone g := by
  obtain ⟨μ, hμ0, rfl⟩ := hx
  obtain ⟨ν, hν0, rfl⟩ := hy
  refine ⟨fun j => μ j + ν j, fun j => add_nonneg (hμ0 j) (hν0 j), ?_⟩
  simp_rw [add_smul, Finset.sum_add_distrib]

theorem M_smul_mem {V : Type*} [AddCommGroup V] [Module ℝ V] {ι : Type*} [Fintype ι]
    (g : ι → V) {x : V} {c : ℝ} (hc : 0 ≤ c) (hx : x ∈ genCone g) : c • x ∈ genCone g := by
  obtain ⟨μ, hμ0, rfl⟩ := hx
  refine ⟨fun j => c * μ j, fun j => mul_nonneg hc (hμ0 j), ?_⟩
  simp_rw [Finset.smul_sum, smul_smul]

theorem M_univ {V : Type*} [AddCommGroup V] [Module ℝ V] [FiniteDimensional ℝ V] :
    ∃ (ι : Type) (_ : Fintype ι) (g : ι → V), genCone g = Set.univ := by
  let b := Module.finBasis ℝ V
  refine ⟨Fin (Module.finrank ℝ V) ⊕ Fin (Module.finrank ℝ V), inferInstance,
    Sum.elim (fun i => b i) (fun i => -b i), ?_⟩
  ext x
  simp only [Set.mem_univ, iff_true]
  refine ⟨Sum.elim (fun i => max (b.repr x i) 0) (fun i => max (-b.repr x i) 0), ?_, ?_⟩
  · intro j
    cases j with
    | inl i => exact le_max_right _ _
    | inr i => exact le_max_right _ _
  · rw [Fintype.sum_sum_type]
    simp only [Sum.elim_inl, Sum.elim_inr, smul_neg]
    rw [← Finset.sum_add_distrib]
    conv_lhs => rw [← b.sum_repr x]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    rw [← sub_eq_add_neg, ← sub_smul, max_zero_sub_max_neg_zero_eq_self]

theorem M_dd_sup {V : Type*} [AddCommGroup V] [Module ℝ V] {ι : Type} [Fintype ι] (g : ι → V)
    (a : ι → ℝ) (μ : ι → ℝ) (hμ : ∀ j, 0 ≤ μ j) (hf : ∑ j, μ j * a j ≤ 0) :
    ∃ μ' : ι ⊕ (ι × ι) → ℝ, (∀ i, 0 ≤ μ' i) ∧
      ∑ j, μ j • g j = ∑ i, μ' i • (Sum.elim (fun j => if a j ≤ 0 then g j else 0)
        (fun p : ι × ι => if 0 < a p.1 ∧ a p.2 < 0 then a p.1 • g p.2 - a p.2 • g p.1 else 0) i) := by
  classical
  -- positive and negative parts
  obtain ⟨P, hP⟩ : ∃ P : ι → ℝ, P = fun j => if 0 < a j then μ j * a j else 0 := ⟨_, rfl⟩
  obtain ⟨N, hN⟩ : ∃ N : ι → ℝ, N = fun k => if a k < 0 then -(μ k * a k) else 0 := ⟨_, rfl⟩
  have hP0 : ∀ j, 0 ≤ P j := by
    intro j; rw [hP]; dsimp only; split_ifs with h
    · exact mul_nonneg (hμ j) h.le
    · exact le_refl 0
  have hN0 : ∀ k, 0 ≤ N k := by
    intro k; rw [hN]; dsimp only; split_ifs with h
    · have := mul_nonpos_of_nonneg_of_nonpos (hμ k) h.le
      linarith
    · exact le_refl 0
  have hsplit : ∑ j, μ j * a j = ∑ j, P j - ∑ j, N j := by
    rw [← Finset.sum_sub_distrib]
    refine Finset.sum_congr rfl (fun j _ => ?_)
    rw [hP, hN]; dsimp only
    rcases lt_trichotomy (a j) 0 with h | h | h
    · simp only [if_neg (not_lt.mpr h.le), if_pos h]; ring
    · simp only [h, lt_irrefl, if_false]; ring
    · simp only [if_pos h, if_neg (not_lt.mpr h.le)]; ring
  obtain ⟨Pp, hPp⟩ : ∃ Pp, Pp = ∑ j, P j := ⟨_, rfl⟩
  obtain ⟨Nn, hNn⟩ : ∃ Nn, Nn = ∑ j, N j := ⟨_, rfl⟩
  have hPN : Pp ≤ Nn := by rw [hPp, hNn]; linarith
  have hPp0 : 0 ≤ Pp := hPp ▸ Finset.sum_nonneg (fun j _ => hP0 j)
  have hNn0 : 0 ≤ Nn := hNn ▸ Finset.sum_nonneg (fun j _ => hN0 j)
  rcases hNn0.eq_or_lt with hN0' | hNpos
  · -- Nn = 0
    have hPp_eq : ∑ j, P j = 0 := by rw [← hPp]; linarith
    have hPj : ∀ j, P j = 0 := fun j =>
      (Finset.sum_eq_zero_iff_of_nonneg (fun j _ => hP0 j)).mp hPp_eq j (Finset.mem_univ j)
    refine ⟨Sum.elim μ (fun _ => 0), ?_, ?_⟩
    · intro i
      cases i with
      | inl j => exact hμ j
      | inr p => exact le_refl 0
    · rw [Fintype.sum_sum_type]
      simp only [Sum.elim_inl, Sum.elim_inr, zero_smul, Finset.sum_const_zero, add_zero]
      refine Finset.sum_congr rfl (fun j _ => ?_)
      split_ifs with h
      · rfl
      · have h' : 0 < a j := lt_of_not_ge h
        have := hPj j
        rw [hP] at this; dsimp only at this
        rw [if_pos h'] at this
        have hμj : μ j = 0 := by
          rcases mul_eq_zero.mp this with h1 | h1
          · exact h1
          · exact absurd h1 h'.ne'
        rw [hμj, zero_smul, smul_zero]
  · -- Nn > 0
    obtain ⟨c, hc⟩ : ∃ c : ι → ℝ, c = fun j => if 0 < a j then μ j else 0 := ⟨_, rfl⟩
    obtain ⟨d, hd⟩ : ∃ d : ι → ℝ, d = fun k => if a k < 0 then μ k else 0 := ⟨_, rfl⟩
    refine ⟨Sum.elim (fun j => if a j < 0 then μ j * (1 - Pp / Nn) else μ j)
      (fun p => μ p.1 * μ p.2 / Nn), ?_, ?_⟩
    · intro i
      cases i with
      | inl j =>
        simp only [Sum.elim_inl]
        split_ifs
        · apply mul_nonneg (hμ j)
          rw [sub_nonneg, div_le_one hNpos]; exact hPN
        · exact hμ j
      | inr p =>
        simp only [Sum.elim_inr]
        exact div_nonneg (mul_nonneg (hμ _) (hμ _)) hNpos.le
    · have key : ∀ j k, (μ j * μ k / Nn) •
          (if 0 < a j ∧ a k < 0 then a j • g k - a k • g j else 0)
          = ((d k / Nn) * P j) • g k + ((c j / Nn) * N k) • g j := by
        intro j k
        rw [hc, hd, hP, hN]
        dsimp only
        by_cases hj : 0 < a j <;> by_cases hk : a k < 0
        · simp only [hj, hk, and_self, if_true]
          module
        · simp [hj, hk]
        · simp [hj, hk]
        · simp [hj, hk]
      rw [Fintype.sum_sum_type, Fintype.sum_prod_type]
      simp only [Sum.elim_inl, Sum.elim_inr]
      rw [Finset.sum_congr rfl (fun j _ => Finset.sum_congr rfl (fun k _ => key j k))]
      simp_rw [Finset.sum_add_distrib]
      rw [Finset.sum_comm (f := fun j k => ((d k / Nn) * P j) • g k)]
      simp_rw [← Finset.sum_smul, ← Finset.mul_sum, ← hPp, ← hNn]
      rw [← Finset.sum_add_distrib, ← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl (fun j _ => ?_)
      rw [hc, hd]
      dsimp only
      rcases lt_trichotomy (a j) 0 with h | h | h
      · simp only [if_pos h, if_pos h.le, if_neg (not_lt.mpr h.le)]
        module
      · simp [h]
      · simp only [if_neg (not_lt.mpr h.le), if_neg (not_le.mpr h), if_pos h]
        rw [div_mul_cancel₀ _ hNpos.ne']
        simp

theorem M_dd {V : Type*} [AddCommGroup V] [Module ℝ V] {ι : Type} [Fintype ι] (g : ι → V)
    (f : Module.Dual ℝ V) :
    ∃ (ι' : Type) (_ : Fintype ι') (g' : ι' → V), genCone g' = genCone g ∩ {x | f x ≤ 0} := by
  classical
  refine ⟨ι ⊕ (ι × ι), inferInstance,
    Sum.elim (fun j => if f (g j) ≤ 0 then g j else 0)
      (fun p : ι × ι => if 0 < f (g p.1) ∧ f (g p.2) < 0
        then f (g p.1) • g p.2 - f (g p.2) • g p.1 else 0), ?_⟩
  apply Set.Subset.antisymm
  · apply Set.subset_inter
    · apply M_genCone_subset
      intro i
      cases i with
      | inl j =>
        simp only [Sum.elim_inl]
        split_ifs
        · exact M_mem_gen g j
        · exact M_zero_mem g
      | inr p =>
        simp only [Sum.elim_inr]
        split_ifs with h
        · rw [sub_eq_add_neg, ← neg_smul]
          exact M_add_mem g (M_smul_mem g h.1.le (M_mem_gen g _))
            (M_smul_mem g (neg_nonneg.mpr h.2.le) (M_mem_gen g _))
        · exact M_zero_mem g
    · apply M_genCone_nonpos
      intro i
      cases i with
      | inl j =>
        simp only [Sum.elim_inl]
        split_ifs with h
        · exact h
        · simp
      | inr p =>
        simp only [Sum.elim_inr]
        split_ifs with h
        · simp only [map_sub, map_smul, smul_eq_mul]
          rw [mul_comm, sub_self]
        · simp
  · rintro x ⟨⟨μ, hμ0, rfl⟩, hfx⟩
    simp only [Set.mem_setOf_eq, map_sum, map_smul, smul_eq_mul] at hfx
    obtain ⟨μ', hμ'0, h⟩ := M_dd_sup g (fun j => f (g j)) μ hμ0 hfx
    exact ⟨μ', hμ'0, h⟩

/-- Minkowski's theorem for polyhedral cones: a polyhedral cone is finitely generated. -/
theorem minkowski_cone {V : Type*} [AddCommGroup V] [Module ℝ V] [FiniteDimensional ℝ V]
    (s : Finset (Module.Dual ℝ V)) :
    ∃ (ι : Type) (_ : Fintype ι) (g : ι → V), genCone g = {x | ∀ f ∈ s, f x ≤ 0} := by
  classical
  induction s using Finset.induction_on with
  | empty =>
    obtain ⟨ι, hι, g, hg⟩ := M_univ (V := V)
    exact ⟨ι, hι, g, by rw [hg]; ext x; simp⟩
  | insert f s hf ih =>
    obtain ⟨ι, hι, g, hg⟩ := ih
    obtain ⟨ι', hι', g', hg'⟩ := M_dd g f
    refine ⟨ι', hι', g', ?_⟩
    rw [hg', hg]
    ext x
    simp only [Set.mem_inter_iff, Set.mem_setOf_eq, Finset.mem_insert, forall_eq_or_imp]
    exact and_comm

-- ===== block H =====
/-- Homogenized Minkowski representation of a polyhedron. -/
theorem polytope_homog (P : Polytope E) :
    ∃ (ι : Type) (_ : Fintype ι) (w : ι → E) (s : ι → ℝ),
      (∀ j, 0 ≤ s j) ∧
      P.carrier = {x | ∃ μ : ι → ℝ, (∀ j, 0 ≤ μ j) ∧ x = ∑ j, μ j • w j ∧ ∑ j, μ j * s j = 1} := by
  classical
  let f : Fin P.m → Module.Dual ℝ (E × ℝ) := fun i =>
    (innerₗ E (P.a i)).comp (LinearMap.fst ℝ E ℝ) - (P.b i) • LinearMap.snd ℝ E ℝ
  let finf : Module.Dual ℝ (E × ℝ) := -(LinearMap.snd ℝ E ℝ)
  have hf : ∀ i (z : E × ℝ), f i z = inner ℝ (P.a i) z.1 - P.b i * z.2 := by
    intro i z
    simp [f]
  have hfinf : ∀ z : E × ℝ, finf z = -z.2 := by
    intro z
    simp [finf]
  obtain ⟨ι, hι, g, hg⟩ := minkowski_cone (insert finf (Finset.univ.image f))
  have hK : ∀ z : E × ℝ, z ∈ genCone g ↔
      (-z.2 ≤ 0 ∧ ∀ i, inner ℝ (P.a i) z.1 - P.b i * z.2 ≤ 0) := by
    intro z
    rw [hg]
    simp only [Set.mem_setOf_eq, Finset.forall_mem_insert, Finset.forall_mem_image,
      Finset.mem_univ, forall_const]
    rw [hfinf]
    simp only [hf]
  refine ⟨ι, hι, fun j => (g j).1, fun j => (g j).2, ?_, ?_⟩
  · intro j
    have hmem : g j ∈ genCone g := by
      refine ⟨Pi.single j 1, ?_, ?_⟩
      · intro k
        by_cases hk : k = j
        · subst hk; simp
        · simp [hk]
      · simp [Pi.single_apply]
    have := ((hK (g j)).1 hmem).1
    show 0 ≤ (g j).2
    linarith
  · ext x
    simp only [Polytope.carrier, Set.mem_setOf_eq]
    constructor
    · intro hx
      have hmem : (x, (1:ℝ)) ∈ genCone g := by
        rw [hK]
        refine ⟨by norm_num, fun i => ?_⟩
        simp only [mul_one]
        linarith [hx i]
      obtain ⟨μ, hμ, hx'⟩ := hmem
      refine ⟨μ, hμ, ?_, ?_⟩
      · have := congrArg Prod.fst hx'
        simp only [Prod.fst_sum, Prod.smul_fst] at this
        exact this
      · have := congrArg Prod.snd hx'
        simp only [Prod.snd_sum, Prod.smul_snd, smul_eq_mul] at this
        exact this.symm
    · rintro ⟨μ, hμ, hx1, hx2⟩
      have hmem : (x, (1:ℝ)) ∈ genCone g := by
        refine ⟨μ, hμ, ?_⟩
        ext
        · simp only [Prod.fst_sum, Prod.smul_fst]
          exact hx1
        · simp only [Prod.snd_sum, Prod.smul_snd, smul_eq_mul]
          exact hx2.symm
      intro i
      have := ((hK _).1 hmem).2 i
      simp only [mul_one] at this
      linarith

-- ===== block K =====
-- ===== K BLOCK 1: replaces the `polar_polyhedral` block in skeleton.lean (helpers K_isPolyhedral_fintype, K_isPolyhedral_univ, K_nonpos_of_forall_mul_le go immediately before polar_polyhedral) =====
omit [FiniteDimensional ℝ E] in
theorem K_isPolyhedral_fintype {ι : Type*} [Fintype ι] (c : ι → E) (d : ι → ℝ) :
    IsPolyhedral {x : E | ∀ j, inner ℝ (c j) x ≤ d j} := by
  classical
  let e := Fintype.equivFin ι
  refine ⟨⟨Fintype.card ι, c ∘ e.symm, d ∘ e.symm⟩, ?_⟩
  ext x
  simp only [Polytope.carrier, Set.mem_setOf_eq, Function.comp]
  constructor
  · intro h j
    have := h (e j)
    simpa using this
  · intro h i
    exact h _

omit [FiniteDimensional ℝ E] in
theorem K_isPolyhedral_univ : IsPolyhedral (Set.univ : Set E) := by
  refine ⟨⟨0, Fin.elim0, Fin.elim0⟩, ?_⟩
  ext x
  simp [Polytope.carrier]

theorem K_nonpos_of_forall_mul_le {D K : ℝ} (h : ∀ t : ℝ, 0 ≤ t → t * D ≤ K) : D ≤ 0 := by
  by_contra hD
  push_neg at hD
  have h0 := h 0 le_rfl
  simp only [zero_mul] at h0
  have h1 := h ((K + 1) / D) (by positivity)
  rw [div_mul_cancel₀ _ hD.ne'] at h1
  linarith

theorem polar_polyhedral (P : Polytope E) (a : E) (α : ℝ) :
    IsPolyhedral {x : E | ∀ v ∈ P.carrier, inner ℝ x v ≤ inner ℝ a v + α} := by
  classical
  by_cases hP : P.carrier = ∅
  · have : {x : E | ∀ v ∈ P.carrier, inner ℝ x v ≤ inner ℝ a v + α} = Set.univ := by
      ext x; simp [hP]
    rw [this]; exact K_isPolyhedral_univ
  · obtain ⟨v₀, hv₀⟩ := Set.nonempty_iff_ne_empty.mpr hP
    obtain ⟨ι, hι, w, s, hs, hPeq⟩ := polytope_homog P
    have key : {x : E | ∀ v ∈ P.carrier, inner ℝ x v ≤ inner ℝ a v + α} =
        {x | ∀ j, inner ℝ (w j) x ≤ inner ℝ (w j) a + α * s j} := by
      ext x
      simp only [Set.mem_setOf_eq]
      constructor
      · intro h j
        rcases (hs j).lt_or_eq with hsj | hsj
        · -- s j > 0
          have hvP : (s j)⁻¹ • w j ∈ P.carrier := by
            rw [hPeq]
            refine ⟨Pi.single j (s j)⁻¹, ?_, ?_, ?_⟩
            · intro k
              rw [Pi.single_apply]; split_ifs
              · exact (inv_pos.mpr hsj).le
              · exact le_rfl
            · simp [Pi.single_apply]
            · simp [Pi.single_apply, hsj.ne']
          have h1 := h _ hvP
          rw [real_inner_smul_right, real_inner_smul_right] at h1
          rw [real_inner_comm x (w j), real_inner_comm a (w j)]
          have h2 := mul_le_mul_of_nonneg_left h1 hsj.le
          rw [mul_add, ← mul_assoc, ← mul_assoc, mul_inv_cancel₀ hsj.ne', one_mul, one_mul] at h2
          linarith
        · -- s j = 0
          rw [hPeq] at hv₀
          obtain ⟨μ₀, hμ₀, hv₀eq, hμ₀s⟩ := hv₀
          have hall : ∀ t : ℝ, 0 ≤ t → t * (inner ℝ x (w j) - inner ℝ a (w j)) ≤
              inner ℝ a v₀ + α - inner ℝ x v₀ := by
            intro t ht
            have hvP : v₀ + t • w j ∈ P.carrier := by
              rw [hPeq]
              refine ⟨μ₀ + Pi.single j t, ?_, ?_, ?_⟩
              · intro k
                simp only [Pi.add_apply]
                have : 0 ≤ (Pi.single j t : ι → ℝ) k := by
                  rw [Pi.single_apply]; split_ifs
                  · exact ht
                  · exact le_rfl
                linarith [hμ₀ k]
              · simp only [Pi.add_apply, add_smul, Finset.sum_add_distrib]
                rw [hv₀eq]
                congr 1
                simp [Pi.single_apply]
              · simp only [Pi.add_apply, add_mul, Finset.sum_add_distrib]
                rw [hμ₀s]
                simp [Pi.single_apply, ← hsj]
            have h1 := h _ hvP
            rw [inner_add_right, inner_add_right, real_inner_smul_right,
              real_inner_smul_right] at h1
            linarith
          have := K_nonpos_of_forall_mul_le hall
          rw [real_inner_comm x (w j), real_inner_comm a (w j), ← hsj, mul_zero]
          linarith
      · intro h v hv
        rw [hPeq] at hv
        obtain ⟨μ, hμ, hveq, hμs⟩ := hv
        have h1 : inner ℝ x v - inner ℝ a v = ∑ j, μ j * (inner ℝ (w j) x - inner ℝ (w j) a) := by
          rw [← inner_sub_left, hveq, inner_sum]
          refine Finset.sum_congr rfl ?_
          intro j _
          rw [real_inner_smul_right, inner_sub_left, real_inner_comm x, real_inner_comm a]
        have h2 : ∑ j, μ j * (inner ℝ (w j) x - inner ℝ (w j) a) ≤ ∑ j, μ j * (α * s j) := by
          apply Finset.sum_le_sum
          intro j _
          apply mul_le_mul_of_nonneg_left _ (hμ j)
          linarith [h j]
        have h3 : ∑ j, μ j * (α * s j) = α := by
          calc ∑ j, μ j * (α * s j) = α * ∑ j, μ j * s j := by
                rw [Finset.mul_sum]
                refine Finset.sum_congr rfl ?_
                intro j _
                ring
            _ = α := by rw [hμs, mul_one]
        linarith
    rw [key]
    exact K_isPolyhedral_fintype _ _
-- ===== END K BLOCK 1 =====

-- ===== K BLOCK 2: replaces the `closure_eq_support` and `isPolyhedral_iInter` blocks (adjacent in skeleton.lean) =====
theorem closure_eq_support (C : Set E) (hC : Convex ℝ C) :
    closure C = {x : E | ∀ v : E, ((inner ℝ x v : ℝ) : EReal) ≤ supportFunction C v} := by
  apply Set.Subset.antisymm
  · intro x hx v
    have hclosed : IsClosed {y : E | ((inner ℝ y v : ℝ) : EReal) ≤ supportFunction C v} := by
      apply isClosed_le
      · exact continuous_coe_real_ereal.comp (continuous_id.inner continuous_const)
      · exact continuous_const
    have hsub : C ⊆ {y : E | ((inner ℝ y v : ℝ) : EReal) ≤ supportFunction C v} := by
      intro y hy
      show ((inner ℝ y v : ℝ) : EReal) ≤ supportFunction C v
      unfold supportFunction
      exact le_sSup (Set.mem_image_of_mem (fun v' : E => ((inner ℝ v' v : ℝ) : EReal)) hy)
    exact closure_minimal hsub hclosed hx
  · intro x hx
    by_contra hxC
    obtain ⟨f, u, hf, hu⟩ := geometric_hahn_banach_closed_point hC.closure isClosed_closure hxC
    have hv : ∀ y, inner ℝ y ((InnerProductSpace.toDual ℝ E).symm f) = f y := by
      intro y
      rw [real_inner_comm]
      exact InnerProductSpace.toDual_symm_apply
    have h1 : supportFunction C ((InnerProductSpace.toDual ℝ E).symm f) ≤ (u : EReal) := by
      apply sSup_le
      rintro _ ⟨y, hy, rfl⟩
      dsimp only
      rw [hv]
      exact EReal.coe_le_coe_iff.mpr (hf y (subset_closure hy)).le
    have h2 := hx ((InnerProductSpace.toDual ℝ E).symm f)
    rw [hv] at h2
    have h3 := h2.trans h1
    rw [EReal.coe_le_coe_iff] at h3
    linarith

theorem isPolyhedral_iInter (n : ℕ) (S : Fin n → Set E) (hS : ∀ i, IsPolyhedral (S i)) :
    IsPolyhedral (⋂ i, S i) := by
  choose Q hQ using hS
  have : (⋂ i, S i) = {x : E | ∀ p : (Σ i, Fin (Q i).m), inner ℝ ((Q p.1).a p.2) x ≤ (Q p.1).b p.2} := by
    ext x
    simp only [Set.mem_iInter, ← hQ]
    simp only [Polytope.carrier, Set.mem_setOf_eq]
    constructor
    · intro h p; exact h p.1 p.2
    · intro h i j; exact h ⟨i, j⟩
  rw [this]
  exact K_isPolyhedral_fintype _ _
-- ===== END K BLOCK 2 =====

-- ===== K BLOCK 3: replaces the `part3_mpr` block in skeleton.lean =====
theorem part3_mpr (C : Set E) (hC : Convex ℝ C) :
    IsPiecewiseLinear (supportFunction C) → IsPolyhedral (closure C) := by
  rintro ⟨g, ⟨n, P, A, a, hD, hP, hg⟩, hfg⟩
  have ha' : ∀ i v, A i v = inner ℝ ((InnerProductSpace.toDual ℝ E).symm (A i)) v :=
    fun i v => (InnerProductSpace.toDual_symm_apply).symm
  have key : closure C = ⋂ i, {x : E | ∀ v ∈ P i,
      inner ℝ x v ≤ inner ℝ ((InnerProductSpace.toDual ℝ E).symm (A i)) v + a i} := by
    rw [closure_eq_support C hC]
    ext x
    simp only [Set.mem_setOf_eq, Set.mem_iInter]
    constructor
    · intro hx i v hv
      have hvD : v ∈ effDom (supportFunction C) := by
        rw [hD]; exact Set.mem_iUnion.mpr ⟨i, hv⟩
      have h1 := hx v
      rw [hfg v hvD, hg i v hv, ha'] at h1
      exact EReal.coe_le_coe_iff.mp h1
    · intro hx v
      by_cases hv : supportFunction C v = ⊤
      · rw [hv]; exact le_top
      · have hvD : v ∈ effDom (supportFunction C) := lt_top_iff_ne_top.mpr hv
        rw [hfg v hvD]
        rw [hD] at hvD
        obtain ⟨i, hi⟩ := Set.mem_iUnion.mp hvD
        rw [hg i v hi, ha']
        exact EReal.coe_le_coe_iff.mpr (hx i v hi)
  rw [key]
  apply isPolyhedral_iInter
  intro i
  obtain ⟨Q, hQ⟩ := hP i
  rw [← hQ]
  exact polar_polyhedral Q _ (a i)
-- ===== END K BLOCK 3 =====

-- ===== block S =====
-- ===== BLOCK 1: replaces `supportFunction_polyhedral_pl` and `supportFunction_closure` (helpers S_* go immediately before them) =====

omit [FiniteDimensional ℝ E] in
theorem S_isPolyhedral_fintype {ι : Type*} [Fintype ι] (c : ι → E) (d : ι → ℝ) :
    IsPolyhedral {x : E | ∀ j, inner ℝ (c j) x ≤ d j} := by
  let e := Fintype.equivFin ι
  refine ⟨⟨Fintype.card ι, c ∘ e.symm, d ∘ e.symm⟩, ?_⟩
  ext x
  simp only [Polytope.carrier, Set.mem_setOf_eq, Function.comp]
  constructor
  · intro h j
    have := h (e j)
    simpa using this
  · intro h i
    exact h _

omit [FiniteDimensional ℝ E] in
theorem S_isPolyhedral_empty : IsPolyhedral (∅ : Set E) := by
  refine ⟨⟨1, fun _ => 0, fun _ => -1⟩, ?_⟩
  ext x
  simp [Polytope.carrier]

omit [FiniteDimensional ℝ E] in
theorem S_pl_of_homog {ι : Type} [Fintype ι] (w : ι → E) (s : ι → ℝ) (hs : ∀ j, 0 ≤ s j)
    (K : Set E)
    (hK : K = {x : E | ∃ μ : ι → ℝ, (∀ j, 0 ≤ μ j) ∧ x = ∑ j, μ j • w j ∧ ∑ j, μ j * s j = 1})
    (hne : K.Nonempty) :
    IsPiecewiseLinear (supportFunction K) := by
  classical
  have hmem : ∀ x, x ∈ K ↔
      ∃ μ : ι → ℝ, (∀ j, 0 ≤ μ j) ∧ x = ∑ j, μ j • w j ∧ ∑ j, μ j * s j = 1 := by
    intro x
    simp only [hK, Set.mem_setOf_eq]
  have hle : ∀ x ∈ K, ∀ v, ((inner ℝ x v : ℝ) : EReal) ≤ supportFunction K v := by
    intro x hx v
    exact le_sSup ⟨x, hx, rfl⟩
  have hbound : ∀ v (M : ℝ), (∀ k, inner ℝ (w k) v ≤ s k * M) →
      supportFunction K v ≤ (M : EReal) := by
    intro v M hM
    apply sSup_le
    rintro _ ⟨x, hx, rfl⟩
    obtain ⟨μ, hμ, rfl, hsum⟩ := (hmem x).1 hx
    show ((inner ℝ (∑ j, μ j • w j) v : ℝ) : EReal) ≤ (M : EReal)
    rw [EReal.coe_le_coe_iff, sum_inner]
    calc ∑ j, inner ℝ (μ j • w j) v = ∑ j, μ j * inner ℝ (w j) v := by
          apply Finset.sum_congr rfl
          intro j _
          rw [real_inner_smul_left]
      _ ≤ ∑ j, μ j * (s j * M) := by
          apply Finset.sum_le_sum
          intro j _
          exact mul_le_mul_of_nonneg_left (hM j) (hμ j)
      _ = (∑ j, μ j * s j) * M := by
          rw [Finset.sum_mul]
          apply Finset.sum_congr rfl
          intro j _
          ring
      _ = M := by rw [hsum, one_mul]
  obtain ⟨x₀, hx₀⟩ := hne
  obtain ⟨μ₀, hμ₀, hx₀eq, hsum₀⟩ := (hmem x₀).1 hx₀
  have hpos : ∃ j, 0 < s j := by
    by_contra h
    push_neg at h
    have h0 : ∀ j, s j = 0 := fun j => le_antisymm (h j) (hs j)
    simp [h0] at hsum₀
  set p : ι → E := fun j => (s j)⁻¹ • w j with hp
  have hpK : ∀ j, 0 < s j → p j ∈ K := by
    intro j hj
    rw [hmem]
    refine ⟨fun k => if k = j then (s j)⁻¹ else 0, ?_, ?_, ?_⟩
    · intro k
      dsimp only
      split_ifs
      · exact inv_nonneg.mpr (hs j)
      · exact le_refl 0
    · simp [ite_smul, hp]
    · simp [ite_mul, hj.ne']
  have hwp : ∀ k, 0 < s k → w k = s k • p k := by
    intro k hk
    simp only [hp]
    rw [smul_inv_smul₀ hk.ne']
  have htop : ∀ v k, s k = 0 → 0 < inner ℝ (w k) v → supportFunction K v = ⊤ := by
    intro v k hk0 hkv
    rw [EReal.eq_top_iff_forall_lt]
    intro r
    obtain ⟨t, ht0, hta⟩ : ∃ t : ℝ, 0 ≤ t ∧
        t * inner ℝ (w k) v = |r| + |inner ℝ x₀ v| + 1 :=
      ⟨(|r| + |inner ℝ x₀ v| + 1) / inner ℝ (w k) v, div_nonneg (by positivity) hkv.le,
        div_mul_cancel₀ _ hkv.ne'⟩
    have hmemt : x₀ + t • w k ∈ K := by
      rw [hmem]
      refine ⟨fun j => μ₀ j + if j = k then t else 0, ?_, ?_, ?_⟩
      · intro j
        dsimp only
        split_ifs
        · linarith [hμ₀ j]
        · linarith [hμ₀ j]
      · simp [add_smul, Finset.sum_add_distrib, ite_smul, hx₀eq]
      · simp [add_mul, Finset.sum_add_distrib, ite_mul, hsum₀, hk0]
    have hval : inner ℝ (x₀ + t • w k) v = inner ℝ x₀ v + t * inner ℝ (w k) v := by
      rw [inner_add_left, real_inner_smul_left]
    have hlt : r < inner ℝ (x₀ + t • w k) v := by
      rw [hval, hta]
      have h1 := le_abs_self r
      have h2 := neg_abs_le (inner ℝ x₀ v)
      linarith
    calc (r : EReal) < ((inner ℝ (x₀ + t • w k) v : ℝ) : EReal) := EReal.coe_lt_coe_iff.mpr hlt
      _ ≤ supportFunction K v := hle _ hmemt v
  have hbot : ∀ v, supportFunction K v ≠ ⊥ := by
    intro v
    exact (lt_of_lt_of_le (EReal.bot_lt_coe _) (hle x₀ hx₀ v)).ne'
  let Q : ι → Set E := fun j =>
    if 0 < s j then {v | ∀ k, inner ℝ (w k - s k • p j) v ≤ 0} else ∅
  have hQpoly : ∀ j, IsPolyhedral (Q j) := by
    intro j
    by_cases hj : 0 < s j
    · simp only [Q, if_pos hj]
      exact S_isPolyhedral_fintype (fun k => w k - s k • p j) (fun _ => 0)
    · simp only [Q, if_neg hj]
      exact S_isPolyhedral_empty
  have hQval : ∀ j, ∀ v ∈ Q j, supportFunction K v = ((inner ℝ (p j) v : ℝ) : EReal) := by
    intro j v hv
    by_cases hj : 0 < s j
    · simp only [Q, if_pos hj, Set.mem_setOf_eq] at hv
      apply le_antisymm
      · apply hbound
        intro k
        have := hv k
        rw [inner_sub_left, real_inner_smul_left] at this
        linarith
      · exact hle _ (hpK j hj) v
    · simp only [Q, if_neg hj] at hv
      exact absurd hv (Set.notMem_empty v)
  have hdom : effDom (supportFunction K) = ⋃ j, Q j := by
    ext v
    simp only [effDom, Set.mem_setOf_eq, Set.mem_iUnion]
    constructor
    · intro hv
      have hk0 : ∀ k, s k = 0 → inner ℝ (w k) v ≤ 0 := by
        intro k hk
        by_contra hcon
        push_neg at hcon
        rw [htop v k hk hcon] at hv
        exact lt_irrefl _ hv
      have hTne : (Finset.univ.filter (fun j => 0 < s j)).Nonempty := by
        obtain ⟨j, hj⟩ := hpos
        exact ⟨j, by simp [hj]⟩
      obtain ⟨j, hjT, hjmax⟩ := Finset.exists_max_image _ (fun j => inner ℝ (p j) v) hTne
      have hj : 0 < s j := by simpa using hjT
      refine ⟨j, ?_⟩
      simp only [Q, if_pos hj, Set.mem_setOf_eq]
      intro k
      rw [inner_sub_left, real_inner_smul_left]
      rcases (hs k).lt_or_eq with hk | hk
      · have hkmax := hjmax k (by simp [hk])
        rw [hwp k hk, real_inner_smul_left]
        have : s k * inner ℝ (p k) v ≤ s k * inner ℝ (p j) v :=
          mul_le_mul_of_nonneg_left hkmax hk.le
        linarith
      · have := hk0 k hk.symm
        rw [← hk]
        linarith
    · rintro ⟨j, hj⟩
      rw [hQval j v hj]
      exact EReal.coe_lt_top _
  let e := Fintype.equivFin ι
  unfold IsPiecewiseLinear IsPiecewiseLinearOn
  refine ⟨fun v => (supportFunction K v).toReal, ⟨Fintype.card ι, fun i => Q (e.symm i),
    fun i => innerSL ℝ (p (e.symm i)), fun _ => 0, ?_, ?_, ?_⟩, ?_⟩
  · rw [hdom]
    ext v
    simp only [Set.mem_iUnion]
    constructor
    · rintro ⟨j, hj⟩
      exact ⟨e j, by simpa using hj⟩
    · rintro ⟨i, hi⟩
      exact ⟨e.symm i, hi⟩
  · intro i
    exact hQpoly _
  · intro i v hv
    simp only [innerSL_apply_apply, add_zero]
    rw [hQval _ v hv, EReal.toReal_coe]
  · intro v hv
    have hv' : supportFunction K v < ⊤ := hv
    exact (EReal.coe_toReal (ne_of_lt hv') (hbot v)).symm

theorem supportFunction_polyhedral_pl (P : Polytope E) (hne : P.carrier.Nonempty) :
    IsPiecewiseLinear (supportFunction P.carrier) := by
  obtain ⟨ι, hι, w, s, hs, hP⟩ := polytope_homog P
  exact S_pl_of_homog w s hs P.carrier hP hne

theorem supportFunction_closure (C : Set E) :
    supportFunction (closure C) = supportFunction C := by
  funext v
  apply le_antisymm
  · apply sSup_le
    rintro _ ⟨x, hx, rfl⟩
    have hcl : IsClosed {y : E | ((inner ℝ y v : ℝ) : EReal) ≤ supportFunction C v} := by
      have hc : Continuous (fun y : E => ((inner ℝ y v : ℝ) : EReal)) :=
        continuous_coe_real_ereal.comp (continuous_id.inner continuous_const)
      exact isClosed_Iic.preimage hc
    have hsub : C ⊆ {y : E | ((inner ℝ y v : ℝ) : EReal) ≤ supportFunction C v} := by
      intro y hy
      show ((inner ℝ y v : ℝ) : EReal) ≤ supportFunction C v
      exact le_sSup ⟨y, hy, rfl⟩
    exact closure_minimal hsub hcl hx
  · exact sSup_le_sSup (Set.image_mono subset_closure)

-- ===== BLOCK 2: replaces `part3_mp` =====

theorem part3_mp (C : Set E) (hC_ne : C.Nonempty) :
    IsPolyhedral (closure C) → IsPiecewiseLinear (supportFunction C) := by
  rintro ⟨P, hP⟩
  have hne : P.carrier.Nonempty := by
    rw [hP]
    exact hC_ne.mono subset_closure
  rw [← supportFunction_closure C, ← hP]
  exact supportFunction_polyhedral_pl P hne

-- ===== block A =====
/-- A nonempty convex set with empty interior lies in a hyperplane `{c | ⟪c, v⟫ = k}`
with `v ≠ 0`. -/
theorem A_exists_normal (C : Set E) (hC : Convex ℝ C) (hC_ne : C.Nonempty)
    (hint : interior C = ∅) : ∃ v : E, v ≠ 0 ∧ ∃ k : ℝ, ∀ c ∈ C, inner ℝ c v = k := by
  have hspan : affineSpan ℝ C ≠ ⊤ := by
    intro h
    have h' := (hC.interior_nonempty_iff_affineSpan_eq_top).2 h
    rw [hint] at h'
    exact Set.not_nonempty_empty h'
  obtain ⟨c₀, hc₀⟩ := hC_ne
  have hDne : (affineSpan ℝ C).direction ≠ ⊤ := by
    intro h
    apply hspan
    exact (AffineSubspace.direction_eq_top_iff_of_nonempty ⟨c₀, mem_affineSpan ℝ hc₀⟩).1 h
  have hDperp : ((affineSpan ℝ C).direction)ᗮ ≠ ⊥ := by
    intro h
    exact hDne (Submodule.orthogonal_eq_bot_iff.1 h)
  obtain ⟨v, hv, hv0⟩ := (Submodule.ne_bot_iff _).1 hDperp
  refine ⟨v, hv0, inner ℝ c₀ v, fun c hc => ?_⟩
  have hmem : c -ᵥ c₀ ∈ (affineSpan ℝ C).direction :=
    AffineSubspace.vsub_mem_direction (mem_affineSpan ℝ hc) (mem_affineSpan ℝ hc₀)
  have h0 : inner ℝ (c - c₀) v = 0 := Submodule.inner_right_of_mem_orthogonal hmem hv
  rw [inner_sub_left] at h0
  linarith

theorem part1b (C : Set E) (hC : Convex ℝ C) (hC_ne : C.Nonempty) :
    interior C = supportInterior C := by
  ext x
  constructor
  · intro hx v hv
    rw [mem_interior_iff_mem_nhds, Metric.mem_nhds_iff] at hx
    obtain ⟨ε, hε, hball⟩ := hx
    have hvn : 0 < ‖v‖ := norm_pos_iff.2 hv
    have hyC : x + (ε / 2 / ‖v‖) • v ∈ C := by
      apply hball
      rw [Metric.mem_ball, dist_eq_norm, add_sub_cancel_left, norm_smul, Real.norm_eq_abs,
        abs_of_pos (by positivity), div_mul_cancel₀ _ hvn.ne']
      linarith
    have hinner : inner ℝ (x + (ε / 2 / ‖v‖) • v) v = inner ℝ x v + ε / 2 * ‖v‖ := by
      rw [inner_add_left, real_inner_smul_left, real_inner_self_eq_norm_sq]
      field_simp
    calc ((inner ℝ x v : ℝ) : EReal) < ((inner ℝ (x + (ε / 2 / ‖v‖) • v) v : ℝ) : EReal) := by
          rw [EReal.coe_lt_coe_iff, hinner]
          have : 0 < ε / 2 * ‖v‖ := by positivity
          linarith
      _ ≤ supportFunction C v := le_sSup (Set.mem_image_of_mem _ hyC)
  · intro hx
    by_contra hxi
    suffices h : ∃ v : E, v ≠ 0 ∧ supportFunction C v ≤ ((inner ℝ x v : ℝ) : EReal) by
      obtain ⟨v, hv0, hle⟩ := h
      exact absurd (hx v hv0) (not_lt.2 hle)
    rcases (interior C).eq_empty_or_nonempty with hint | hint
    · obtain ⟨v, hv0, k, hk⟩ := A_exists_normal C hC hC_ne hint
      by_cases hxk : k ≤ inner ℝ x v
      · refine ⟨v, hv0, sSup_le ?_⟩
        rintro _ ⟨c, hc, rfl⟩
        rw [EReal.coe_le_coe_iff, hk c hc]
        exact hxk
      · refine ⟨-v, neg_ne_zero.2 hv0, sSup_le ?_⟩
        rintro _ ⟨c, hc, rfl⟩
        rw [EReal.coe_le_coe_iff, inner_neg_right, inner_neg_right, hk c hc]
        push_neg at hxk
        linarith
    · obtain ⟨f, hf⟩ := geometric_hahn_banach_open_point hC.interior isOpen_interior hxi
      have hfv : ∀ y, inner ℝ ((InnerProductSpace.toDual ℝ E).symm f) y = f y :=
        fun y => InnerProductSpace.toDual_symm_apply
      have hv0 : (InnerProductSpace.toDual ℝ E).symm f ≠ 0 := by
        intro h0
        obtain ⟨a, ha⟩ := hint
        have h1 := hf a ha
        rw [← hfv, ← hfv, h0, inner_zero_left, inner_zero_left] at h1
        exact lt_irrefl _ h1
      refine ⟨(InnerProductSpace.toDual ℝ E).symm f, hv0, sSup_le ?_⟩
      rintro _ ⟨c, hc, rfl⟩
      rw [EReal.coe_le_coe_iff, real_inner_comm, real_inner_comm _ x, hfv, hfv]
      have hcl : c ∈ closure (interior C) := by
        rw [hC.closure_interior_eq_closure_of_nonempty_interior hint]
        exact subset_closure hc
      have hclosed : IsClosed {y : E | f y ≤ f x} := isClosed_le f.continuous continuous_const
      have hsub : interior C ⊆ {y : E | f y ≤ f x} := fun a ha => (hf a ha).le
      exact closure_minimal hsub hclosed hcl

-- ===== block C =====
-- Drop-in replacement for the `part4` block:

theorem part4 (C : Set E) (hC_ne : C.Nonempty) :
    (C.Nonempty ∧ Bornology.IsBounded C) ↔ ∀ (v : E), supportFunction C v < ⊤ := by
  constructor
  · rintro ⟨-, hb⟩ v
    obtain ⟨R, hR⟩ := isBounded_iff_forall_norm_le.mp hb
    have hle : supportFunction C v ≤ ((R * ‖v‖ : ℝ) : EReal) := by
      unfold supportFunction
      apply sSup_le
      rintro _ ⟨c, hc, rfl⟩
      simp only [EReal.coe_le_coe_iff]
      calc inner ℝ c v ≤ ‖c‖ * ‖v‖ := real_inner_le_norm c v
        _ ≤ R * ‖v‖ := mul_le_mul_of_nonneg_right (hR c hc) (norm_nonneg v)
    exact lt_of_le_of_lt hle (EReal.coe_lt_top _)
  · intro h
    refine ⟨hC_ne, ?_⟩
    have hbd : ∀ v : E, ∃ r : ℝ, ∀ c ∈ C, inner ℝ c v ≤ r := by
      intro v
      refine ⟨(supportFunction C v).toReal, fun c hc => ?_⟩
      have h1 : ((inner ℝ c v : ℝ) : EReal) ≤ supportFunction C v := le_sSup ⟨c, hc, rfl⟩
      have h2 : supportFunction C v ≠ ⊤ := (h v).ne
      have h3 : supportFunction C v ≠ ⊥ := ne_bot_of_le_ne_bot (EReal.coe_ne_bot _) h1
      rw [← EReal.coe_le_coe_iff, EReal.coe_toReal h2 h3]
      exact h1
    choose r hr using hbd
    let b := stdOrthonormalBasis ℝ E
    rw [isBounded_iff_forall_norm_le]
    refine ⟨∑ i, (|r (b i)| + |r (-b i)|), fun c hc => ?_⟩
    have hc_eq : ∑ i, inner ℝ (b i) c • b i = c := b.sum_repr' c
    calc ‖c‖ = ‖∑ i, inner ℝ (b i) c • b i‖ := by rw [hc_eq]
      _ ≤ ∑ i, ‖inner ℝ (b i) c • b i‖ := norm_sum_le _ _
      _ = ∑ i, |inner ℝ (b i) c| := by
          apply Finset.sum_congr rfl
          intro i _
          rw [norm_smul, b.orthonormal.1 i, mul_one, Real.norm_eq_abs]
      _ ≤ ∑ i, (|r (b i)| + |r (-b i)|) := by
          apply Finset.sum_le_sum
          intro i _
          rw [abs_le]
          constructor
          · have := hr (-b i) c hc
            rw [inner_neg_right, real_inner_comm] at this
            linarith [le_abs_self (r (-b i)), abs_nonneg (r (b i))]
          · have := hr (b i) c hc
            rw [real_inner_comm] at this
            linarith [le_abs_self (r (b i)), abs_nonneg (r (-b i))]

-- Drop-in replacement for the `part2` block (helpers go immediately before part2, after part1b):

omit [FiniteDimensional ℝ E] in
theorem C_setSub_convex (C₁ C₂ : Set E) (hC₁ : Convex ℝ C₁) (hC₂ : Convex ℝ C₂) :
    Convex ℝ (setSub C₁ C₂) := by
  intro x hx y hy a b ha hb hab
  obtain ⟨c, hc, k, hk, rfl⟩ := hx
  obtain ⟨c', hc', k', hk', rfl⟩ := hy
  refine ⟨a • c + b • c', hC₁ hc hc' ha hb hab, a • k + b • k', ?_, ?_⟩
  · show -(a • k + b • k') ∈ C₂
    have h := hC₂ hk hk' ha hb hab
    have he : -(a • k + b • k') = a • -k + b • -k' := by
      rw [smul_neg, smul_neg, neg_add]
    rw [he]
    exact h
  · rw [smul_add, smul_add]
    abel

omit [InnerProductSpace ℝ E] [FiniteDimensional ℝ E] in
theorem C_setSub_nonempty (C₁ C₂ : Set E) (hC₁_ne : C₁.Nonempty) (hC₂_ne : C₂.Nonempty) :
    (setSub C₁ C₂).Nonempty := by
  obtain ⟨c, hc⟩ := hC₁_ne
  obtain ⟨d, hd⟩ := hC₂_ne
  refine ⟨c + -d, c, hc, -d, ?_, rfl⟩
  show - -d ∈ C₂
  rw [neg_neg]
  exact hd

omit [FiniteDimensional ℝ E] in
theorem C_pos_support_setSub (C₁ C₂ : Set E) (v : E) :
    (0 : EReal) < supportFunction (setSub C₁ C₂) v ↔
      ∃ c ∈ C₁, ∃ d ∈ C₂, inner ℝ d v < inner ℝ c v := by
  unfold supportFunction
  rw [lt_sSup_iff]
  constructor
  · rintro ⟨_, ⟨x, hx, rfl⟩, hpos⟩
    obtain ⟨c, hc, k, hk, rfl⟩ := hx
    refine ⟨c, hc, -k, hk, ?_⟩
    rw [← EReal.coe_zero, EReal.coe_lt_coe_iff, inner_add_left] at hpos
    rw [inner_neg_left]
    linarith
  · rintro ⟨c, hc, d, hd, hlt⟩
    refine ⟨_, ⟨c + -d, ⟨c, hc, -d, ?_, rfl⟩, rfl⟩, ?_⟩
    · show - -d ∈ C₂
      rw [neg_neg]
      exact hd
    · rw [← EReal.coe_zero, EReal.coe_lt_coe_iff, inner_add_left, inner_neg_left]
      linarith

omit [FiniteDimensional ℝ E] in
theorem C_not_le_support (C₁ C₂ : Set E) (v : E) :
    ¬ (supportFunction C₁ v ≤ - supportFunction C₂ (-v)) ↔
      ∃ c ∈ C₁, ∃ d ∈ C₂, inner ℝ d v < inner ℝ c v := by
  rw [not_le]
  unfold supportFunction
  rw [lt_sSup_iff]
  constructor
  · rintro ⟨_, ⟨c, hc, rfl⟩, hlt⟩
    rw [EReal.neg_lt_comm, lt_sSup_iff] at hlt
    obtain ⟨_, ⟨d, hd, rfl⟩, hlt2⟩ := hlt
    refine ⟨c, hc, d, hd, ?_⟩
    rw [← EReal.coe_neg, EReal.coe_lt_coe_iff, inner_neg_right] at hlt2
    linarith
  · rintro ⟨c, hc, d, hd, hlt⟩
    refine ⟨_, ⟨c, hc, rfl⟩, ?_⟩
    rw [EReal.neg_lt_comm, lt_sSup_iff]
    refine ⟨_, ⟨d, hd, rfl⟩, ?_⟩
    rw [← EReal.coe_neg, EReal.coe_lt_coe_iff, inner_neg_right]
    linarith

theorem part2 (C₁ C₂ : Set E) (hC₁ : Convex ℝ C₁) (hC₂ : Convex ℝ C₂)
    (hC₁_ne : C₁.Nonempty) (hC₂_ne : C₂.Nonempty) :
    (0 : E) ∈ interior (setSub C₁ C₂) ↔
      ¬ ∃ v : E, v ≠ 0 ∧ supportFunction C₁ v ≤ - supportFunction C₂ (-v) := by
  rw [part1b _ (C_setSub_convex C₁ C₂ hC₁ hC₂) (C_setSub_nonempty C₁ C₂ hC₁_ne hC₂_ne)]
  have h0 : ∀ v : E, (((inner ℝ (0 : E) v) : ℝ) : EReal) = 0 := by
    intro v
    rw [inner_zero_left, EReal.coe_zero]
  constructor
  · rintro h ⟨v, hv, hle⟩
    have hpos := h v hv
    rw [h0 v] at hpos
    exact (C_not_le_support C₁ C₂ v).mpr ((C_pos_support_setSub C₁ C₂ v).mp hpos) hle
  · intro h v hv
    rw [h0 v]
    apply (C_pos_support_setSub C₁ C₂ v).mpr
    apply (C_not_le_support C₁ C₂ v).mp
    intro hle
    exact h ⟨v, hv, hle⟩

-- ===== block B =====
theorem B_exists_normal (C : Set E) (hC : Convex ℝ C) (hC_ne : C.Nonempty)
    (h : interior C = ∅) :
    ∃ v : E, v ≠ 0 ∧ ∃ k : ℝ, ∀ c ∈ C, inner ℝ c v = k := by
  have hspan : affineSpan ℝ C ≠ ⊤ := by
    intro htop
    have hne : (interior C).Nonempty := hC.interior_nonempty_iff_affineSpan_eq_top.2 htop
    rw [h] at hne
    exact Set.not_nonempty_empty hne
  have hvec : vectorSpan ℝ C ≠ ⊤ := by
    intro htop
    exact hspan
      ((AffineSubspace.affineSpan_eq_top_iff_vectorSpan_eq_top_of_nonempty ℝ E E hC_ne).2 htop)
  have hperp : (vectorSpan ℝ C)ᗮ ≠ ⊥ := by
    intro hbot
    exact hvec (Submodule.orthogonal_eq_bot_iff.1 hbot)
  obtain ⟨v, hv, hv0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hperp
  obtain ⟨c₀, hc₀⟩ := hC_ne
  refine ⟨v, hv0, inner ℝ c₀ v, fun c hc => ?_⟩
  have hd : c -ᵥ c₀ ∈ vectorSpan ℝ C := vsub_mem_vectorSpan ℝ hc hc₀
  have h0 : inner ℝ (c - c₀) v = 0 := Submodule.inner_right_of_mem_orthogonal hd hv
  rw [inner_sub_left, sub_eq_zero] at h0
  exact h0

omit [FiniteDimensional ℝ E] in
theorem B_supportFunction_const (C : Set E) (hC_ne : C.Nonempty) (v : E) (k : ℝ)
    (h : ∀ c ∈ C, inner ℝ c v = k) :
    supportFunction C v = (k : EReal) := by
  unfold supportFunction
  have himg : (fun c : E => ((inner ℝ c v : ℝ) : EReal)) '' C = {(k : EReal)} := by
    ext y
    simp only [Set.mem_image, Set.mem_singleton_iff]
    constructor
    · rintro ⟨c, hc, rfl⟩
      rw [h c hc]
    · rintro rfl
      obtain ⟨c, hc⟩ := hC_ne
      exact ⟨c, hc, by rw [h c hc]⟩
  rw [himg, sSup_singleton]

theorem part1a (C : Set E) (hC : Convex ℝ C) (hC_ne : C.Nonempty) :
    (interior C).Nonempty ↔ ¬ ∃ v : E, v ≠ 0 ∧ supportFunction C v = - supportFunction C (-v) := by
  constructor
  · rintro ⟨x, hx⟩ ⟨v, hv0, hv⟩
    rw [part1b C hC hC_ne] at hx
    have h1 : ((inner ℝ x v : ℝ) : EReal) < supportFunction C v := hx v hv0
    have h2 : ((inner ℝ x (-v) : ℝ) : EReal) < supportFunction C (-v) :=
      hx (-v) (neg_ne_zero.2 hv0)
    rw [inner_neg_right, EReal.coe_neg] at h2
    have h3 : - supportFunction C (-v) < ((inner ℝ x v : ℝ) : EReal) :=
      EReal.neg_lt_comm.1 h2
    rw [hv] at h1
    exact lt_asymm h1 h3
  · intro hno
    by_contra hint
    rw [Set.not_nonempty_iff_eq_empty] at hint
    obtain ⟨v, hv0, k, hk⟩ := B_exists_normal C hC hC_ne hint
    apply hno
    refine ⟨v, hv0, ?_⟩
    have h1 : supportFunction C v = (k : EReal) := B_supportFunction_const C hC_ne v k hk
    have h2 : supportFunction C (-v) = ((-k : ℝ) : EReal) :=
      B_supportFunction_const C hC_ne (-v) (-k) (fun c hc => by rw [inner_neg_right, hk c hc])
    rw [h1, h2, EReal.coe_neg, neg_neg]

theorem RW_chap_8_29
  (C C₁ C₂ : Set E)
  (hC : Convex ℝ C)
  (hC₁ : Convex ℝ C₁)
  (hC₂ : Convex ℝ C₂)
  (hC_ne : C.Nonempty)
  (hC₁_ne : C₁.Nonempty)
  (hC₂_ne : C₂.Nonempty) :
  (((interior C).Nonempty ↔
      ¬ ∃ v : E, v ≠ 0 ∧ supportFunction C v = - supportFunction C (-v)) ∧
    (interior C = supportInterior C)) ∧
  (((0 : E) ∈ interior (setSub C₁ C₂) ↔
      ¬ ∃ v : E, v ≠ 0 ∧ supportFunction C₁ v ≤ - supportFunction C₂ (-v))) ∧
  ((IsPolyhedral (closure C) ↔ IsPiecewiseLinear (supportFunction C))) ∧
  ((C.Nonempty ∧ Bornology.IsBounded C) ↔
      ∀ (v : E), supportFunction C v < ⊤) := by
  exact ⟨⟨part1a C hC hC_ne, part1b C hC hC_ne⟩, part2 C₁ C₂ hC₁ hC₂ hC₁_ne hC₂_ne,
    ⟨part3_mp C hC_ne, part3_mpr C hC⟩, part4 C hC_ne⟩

end RW_chap_8_29
