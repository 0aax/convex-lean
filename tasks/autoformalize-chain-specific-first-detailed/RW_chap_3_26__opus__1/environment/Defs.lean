import Mathlib

/-!
# Shared definitions of the formalization project

Extended-real-valued functions are `f : E → EReal`; `+∞` is `⊤` and `-∞` is `⊥`.
-/

open Filter Topology

section ExtendedRealFunctions

variable {E : Type*}

/-- The effective domain `{x | f x < +∞}` of an extended-real-valued function. -/
def effDom (f : E → EReal) : Set E := {x | f x < ⊤}

/-- The epigraph `{(x, r) ∈ E × ℝ | f x ≤ r}` of an extended-real-valued function. -/
def epigraph (f : E → EReal) : Set (E × ℝ) := {p | f p.1 ≤ (p.2 : EReal)}

/-- Convexity of an extended-real-valued function, defined as convexity of its epigraph. -/
def ConvexEReal [AddCommMonoid E] [Module ℝ E] (f : E → EReal) : Prop :=
  Convex ℝ (epigraph f)

/-- The function whose epigraph is (generated by) the set `S ⊆ E × ℝ`:
`x ↦ inf {r ∈ ℝ | (x, r) ∈ S}`, with `inf ∅ = +∞`. -/
noncomputable def funFromSet (S : Set (E × ℝ)) : E → EReal :=
  fun x => sInf ((fun r : ℝ => (r : EReal)) '' {r | (x, r) ∈ S})

end ExtendedRealFunctions

/-- The (sequential) horizon cone of a set `C` (Rockafellar–Wets, Definition 3.3):
`C^∞ = {d | ∃ xᵛ ∈ C, λᵛ ↘ 0, λᵛ • xᵛ → d}`. For a nonempty closed convex set it is the
asymptotic (recession) cone `{d | x + t • d ∈ C for all t > 0}` of any `x ∈ C`. -/
def horizonCone {V : Type*} [AddCommGroup V] [Module ℝ V] [TopologicalSpace V] (C : Set V) :
    Set V :=
  {d | ∃ (x : ℕ → V) (lam : ℕ → ℝ), (∀ n, x n ∈ C) ∧ (∀ n, 0 < lam n) ∧ Antitone lam ∧
    Tendsto lam atTop (𝓝 0) ∧ Tendsto (fun n => lam n • x n) atTop (𝓝 d)}

/-- The asymptotic (recession, horizon) function `f'_∞` of `f : E → EReal`, defined through
the epigraph: `epi f'_∞ = (epi f)^∞`. It has no base point; difference-quotient formulas such
as `sup_{t > 0} (f (x₀ + t • d) - f x₀) / t` are theorems about it. -/
noncomputable def asymptoticFun {E : Type*} [AddCommGroup E] [Module ℝ E] [TopologicalSpace E]
    (f : E → EReal) : E → EReal :=
  funFromSet (horizonCone (epigraph f))
