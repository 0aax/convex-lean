\maketitle

\begin{conjecture}[Kalai's $3^d$ conjecture]
Every centrally symmetric $d$-polytope $P \subset \mathbb{R}^d$ has at least $3^d$ nonempty faces:
\begin{align*}
  \sum_{k = 0}^d f_k (P) \ \ge \ 3^d.
\end{align*}
\end{conjecture}

\end{document}
