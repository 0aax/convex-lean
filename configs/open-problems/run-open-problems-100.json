{
  "job_name": "open-problems-100",
  "n_concurrent_trials": 5,
  "environment_build_timeout_multiplier": 4.0,
  "n_attempts": 1,
  "environment": {
    "type": "daytona",
    "delete": false,
    "kwargs": {
      "auto_delete_interval_mins": 5760
    }
  },
  "agents": [
    {
      "import_path": "claude_code_thinking:GatedClaudeCodeThinking",
      "model_name": "anthropic/claude-fable-5-1",
      "env": {
        "CLAUDE_CODE_PRINT_BG_WAIT_CEILING_MS": "0"
      },
      "kwargs": {
        "max_budget_usd": "100",
        "gate_cap_usd": "100",
        "gate_time_limit_sec": "345600",
        "gate_idle_cycles": "25",
        "gate_continue_message": "You have permission to keep working on this problem, and there is no need to conserve the remaining budget.",
        "prompt_template_path": "configs/open-problems/prompt_template.md",
        "thinking_display": "summarized",
        "reasoning_effort": "max",
        "version": "2.1.257"
      }
    }
  ],
  "tasks": [
